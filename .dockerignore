site/
docs/
mkdocs.yml

# === Project assets (README screenshots ~50MB) ===
assets/

# === Environment & secrets ===
.env
.env.local
.env.*

# === Docker files (prevent recursive context) ===
Dockerfile
docker-compose.yml
.dockerignore
